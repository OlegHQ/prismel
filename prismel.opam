# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A modern, functional graphics framework for OCaml"
description:
  "A clean, type-safe API for creating interactive graphics applications, games, and generative art in OCaml"
maintainer: ["Oleg Pustovit <oleg@nexo.sh>"]
authors: ["Oleg Pustovit <oleg@nexo.sh>"]
license: "MIT"
tags: ["ocaml" "graphics" "framework" "creative-coding" "gamedev"]
homepage: "https://github.com/nexo-tech/prismel"
doc: "https://nexo.sh/prismel"
bug-reports: "https://github.com/nexo-tech/prismel/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17" & >= "3.17"}
  "tsdl"
  "tsdl-image"
  "tsdl-ttf"
  "tsdl-mixer"
  "ctypes"
  "ctypes-foreign"
  "dune-configurator"
  "odoc" {with-doc}
  "utop" {with-test}
  "domainslib"
  "conf-sdl2"
  "conf-sdl2-image"
  "conf-sdl2-ttf"
  "conf-sdl2-mixer"
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/nexo-tech/prismel.git"
