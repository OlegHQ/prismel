(rule
 (alias runtest)
 (action
  (progn
   (run %{exe:bench_raster2_renderer.exe} basic --warmup 0 --samples 2 --frames 2 --check)
   (run %{exe:bench_raster2_renderer.exe} path --warmup 0 --samples 1 --frames 1 --check)
   (run %{exe:bench_raster2_renderer.exe} text --warmup 0 --samples 1 --frames 1 --check)
   (run %{exe:bench_raster2_renderer.exe} scene3 --warmup 0 --samples 1 --frames 1 --check)
   (run %{exe:bench_raster2_renderer.exe} offscreen --warmup 0 --samples 1 --frames 1 --check))))

