; Builds every bench without running one, so they keep compiling.
(alias
 (name bench-build)
 (deps
  bench_circle_from_edges.exe
  bench_convex_hull.exe
  bench_delaunay2.exe
  bench_extract_centroid.exe
  bench_extract_point_curve.exe
  bench_graph_color.exe
