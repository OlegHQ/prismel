(rule
 (targets bench_metal_ffi_bridge.o libbench_metal_ffi_stubs.a
  dllbench_metal_ffi_stubs.so)
 (deps bench_metal_ffi_bridge.mm)
 (action
  (run %{exe:../lib/metal/build_bridge.exe}
   --sanitizers none
   --profile %{profile}
   --ocaml-include %{ocaml-config:standard_library}
   --source %{dep:bench_metal_ffi_bridge.mm}
   --object bench_metal_ffi_bridge.o
   --archive libbench_metal_ffi_stubs.a
   --shared dllbench_metal_ffi_stubs.so)))

(executable
