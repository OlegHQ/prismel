  $ cat > a.rays <<'X'
  > (workspace a
  >   ; kept verbatim
  >   (graph g :context sop (sop/box)))
  > X
  $ rays-lisp ml a.rays
  (* generated by rays-lisp from a.rays; do not edit *)
  let () =
    Rays_editor.Workspace.main
      ~path:"a.rays"
