  $ echo '(workspace one (graph g :context sop (sop/box)))' > s/one/sketch.rays
  $ echo '(workspace two (graph g :context sop (sop/box)))' > s/two/sketch.rays
  $ echo '(executable (name main))' > s/plain/dune
  $ rays-lisp dune s
