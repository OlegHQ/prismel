extern "C" CAMLprim value caml_prismel_metal4_queue_copy_buffer_mappings(value queue_raw,value source_raw,value destination_raw,value operations,value active_raw){CAMLparam5(queue_raw,source_raw,destination_raw,operations,active_raw);if(!Bool_val(active_raw))CAMLreturn(result_error_text("Metal4 command queue is closed"));if(@available(macOS 26.0,*)){@try{id<MTL4CommandQueue>queue=object_of_handle(queue_raw,Handle_kind::Command_queue4);id<MTLBuffer>source=object_of_handle(source_raw,Handle_kind::Buffer),destination=object_of_handle(destination_raw,Handle_kind::Buffer);if(source.device.registryID!=queue.device.registryID||destination.device.registryID!=queue.device.registryID)CAMLreturn(result_error_text("sparse buffer mapping device mismatch"));std::vector<MTL4CopySparseBufferMappingOperation>native(Wosize_val(operations));for(mlsize_t i=0;i<Wosize_val(operations);i++){value op=Field(operations,i);int64_t location=Int64_val(Field(op,0)),length=Int64_val(Field(op,1)),destination_offset=Int64_val(Field(op,2));if(location<0||length<=0||destination_offset<0||(uint64_t)location>source.length||(uint64_t)length>source.length-location||(uint64_t)destination_offset>destination.length||(uint64_t)length>destination.length-destination_offset)CAMLreturn(result_error_text("sparse buffer copy mapping out of range"));native[i]={NSMakeRange(location,length),(NSUInteger)destination_offset};}[queue copyBufferMappingsFromBuffer:source toBuffer:destination operations:native.data() count:native.size()];CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal4 command queues require macOS 26"));}

