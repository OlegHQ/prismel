/* operation: 0 add residency, 1 signal drawable, 2 wait drawable, 3 wait event. */
extern "C" CAMLprim value caml_prismel_metal4_queue_synchronize(value queue_raw,value operation_raw,value object_raw,value number_raw,value shared_event_raw,value active_raw){CAMLparam5(queue_raw,operation_raw,object_raw,number_raw,shared_event_raw);CAMLxparam1(active_raw);if(!Bool_val(active_raw))CAMLreturn(result_error_text("Metal4 command queue is closed"));if(@available(macOS 26.0,*)){@try{id<MTL4CommandQueue>queue=object_of_handle(queue_raw,Handle_kind::Command_queue4);int operation=Long_val(operation_raw);if(operation==0){id<MTLResidencySet>set=object_of_handle(object_raw,Handle_kind::Residency_set);if(set.device.registryID!=queue.device.registryID)CAMLreturn(result_error_text("Metal4 residency set device mismatch"));[queue addResidencySet:set];}else if(operation==1||operation==2){id<CAMetalDrawable>drawable=object_of_handle(object_raw,Handle_kind::Metal_drawable);if(drawable.texture.device.registryID!=queue.device.registryID)CAMLreturn(result_error_text("Metal4 drawable device mismatch"));if(operation==1)[queue signalDrawable:drawable];else[queue waitForDrawable:drawable];}else if(operation==3){int64_t number=Int64_val(number_raw);if(number<0)CAMLreturn(result_error_text("Metal4 event value must be non-negative"));id<MTLEvent>event=Bool_val(shared_event_raw)?object_of_handle(object_raw,Handle_kind::Shared_event):object_of_handle(object_raw,Handle_kind::Event);if(event.device==nil||event.device.registryID!=queue.device.registryID)CAMLreturn(result_error_text("Metal4 event device mismatch"));[queue waitForEvent:event value:(uint64_t)number];}else CAMLreturn(result_error_text("unknown Metal4 queue synchronization operation"));CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal4 command queues require macOS 26"));}
extern "C" CAMLprim value caml_prismel_metal4_queue_synchronize_bytecode(value*argv,int argc){(void)argc;return caml_prismel_metal4_queue_synchronize(argv[0],argv[1],argv[2],argv[3],argv[4],argv[5]);}
