extern "C" CAMLprim value caml_prismel_metal4_encoder_update_fence(value re,value rb,value rf,value rstages){CAMLparam4(re,rb,rf,rstages);if(@available(macOS 26.0,*)){@try{id<MTL4CommandEncoder>e;PrismelMetal4CommandBufferState*s;NSString*f=nil;if(!prismel_metal4_encoder_graph(re,rb,&e,&s,&f))CAMLreturn(result_error(f));id<MTLFence>x=object_of_handle(rf,Handle_kind::Fence);if(x.device.registryID!=s.commandBuffer.device.registryID)CAMLreturn(result_error_text("Metal4 fence belongs to another device"));[e updateFence:x afterEncoderStages:(MTLStages)Int64_val(rstages)];[s retainEncodedObject:x];CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}M4_TRY}

static value prismel_metal4_queue_residencies(value rq,value raw_sets,bool add){CAMLparam2(rq,raw_sets);if(@available(macOS 26.0,*)){@try{id<MTL4CommandQueue>q=object_of_handle(rq,Handle_kind::Command_queue4);mlsize_t n=Wosize_val(raw_sets);NSMutableArray*held=[NSMutableArray arrayWithCapacity:n];std::vector<id<MTLResidencySet>> sets;sets.reserve(n);for(mlsize_t i=0;i<n;i++){id<MTLResidencySet>s=object_of_handle(Field(raw_sets,i),Handle_kind::Residency_set);if(s.device.registryID!=q.device.registryID)CAMLreturn(result_error_text("Metal4 residency set belongs to another device"));sets.push_back(s);[held addObject:s];}if(add)[q addResidencySets:sets.data() count:n];else[q removeResidencySets:sets.data() count:n];CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}M4_TRY}
