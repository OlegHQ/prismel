static bool prismel_metal4_nonnegative_pair(value raw, NSRange *range) {
  int64_t location=Int64_val(Field(raw,0)), length=Int64_val(Field(raw,1));
  if(location<0||length<0)return false;
  *range=NSMakeRange((NSUInteger)location,(NSUInteger)length);return true;
}
static bool prismel_metal4_encoder_graph(value re,value rb,id<MTL4CommandEncoder>*encoder,
 PrismelMetal4CommandBufferState**state,NSString**failure){
 *encoder=object_of_handle(re,Handle_kind::Compute_encoder4);
 *state=command_buffer4_state_of_handle(rb);
 if((*encoder).commandBuffer!=(*state).commandBuffer){*failure=@"Metal4 encoder belongs to another command graph";return false;}return true;
}
