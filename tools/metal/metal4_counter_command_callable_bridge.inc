extern "C" CAMLprim value caml_prismel_metal4_counter_invalidate(value rh,value rr){CAMLparam2(rh,rr);if(@available(macOS 26.0,*)){@try{id<MTL4CounterHeap>h=object_of_handle(rh,Handle_kind::Counter_heap4);NSRange r;if(!prismel_metal4_nonnegative_pair(rr,&r)||r.location>h.count||r.length>h.count-r.location)CAMLreturn(result_error_text("Metal4 counter range out of bounds"));[h invalidateCounterRange:r];CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}M4_TRY}
