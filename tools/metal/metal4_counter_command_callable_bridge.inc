extern "C" CAMLprim value caml_prismel_metal4_encoder_debug(value re,value rb,value rs,value rop){CAMLparam4(re,rb,rs,rop);if(@available(macOS 26.0,*)){@try{id<MTL4CommandEncoder>e;PrismelMetal4CommandBufferState*s;NSString*f=nil;if(!prismel_metal4_encoder_graph(re,rb,&e,&s,&f))CAMLreturn(result_error(f));NSString*x=string_from_ocaml(rs);if(!x)CAMLreturn(result_error_text("invalid UTF-8 debug label"));switch(Long_val(rop)){case 0:[e insertDebugSignpost:x];break;case 1:[e pushDebugGroup:x];break;default:CAMLreturn(result_error_text("invalid debug operation"));}CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}M4_TRY}
