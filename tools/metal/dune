(library
 (name metal_inventory_classification)
 (wrapped false)
 (modules
  binding_spec
  binding_plan_render
  binding_plan_compute
  binding_plan_resource
  binding_plan
  classification)
 (libraries gpu_migration_support))

(executable
 (name generate_bindings)
 (modules generate_bindings)
 (libraries
  compiler-libs.common
  gpu_migration_support
  metal_inventory_classification
  yojson))

(test
 (name test_generate_bindings)
 (modules test_generate_bindings)
 (libraries
  gpu_migration_support
  metal_inventory_classification
  unix
  yojson)
 (deps
  generate_bindings.exe
  binding_spec.ml
  binding_spec.mli
  binding_plan.ml
  binding_plan.mli
  binding_plan_render.ml
  binding_plan_compute.ml
  binding_plan_resource.ml
  generate_bindings.ml
  ../../lib/metal/metal.cma
  ../../lib/metal/generated_api_inventory.json
  ../../lib/metal/metal_bridge.mm
  ../../lib/metal/metal.ml
  ../../lib/metal/metal_raw.ml
  ../../lib/metal/metal_raw.mli
  ../../lib/metal/test_metal.ml)
 (action
  (run %{test}
   --generator %{exe:generate_bindings.exe}
   --inventory %{dep:../../lib/metal/generated_api_inventory.json}
   --plan-root %{workspace_root}
   --generator-source %{dep:generate_bindings.ml}
   --manual-native %{dep:../../lib/metal/metal_bridge.mm}
   --manual-raw-ml %{dep:../../lib/metal/metal_raw.ml}
   --manual-raw-mli %{dep:../../lib/metal/metal_raw.mli}
   --safe-source %{dep:../../lib/metal/metal.ml}
   --safe-tests %{dep:../../lib/metal/test_metal.ml})))

