/* ParallelRender8 isolated shard. active and open_children are safe-state
   witnesses owned by the command-buffer graph; native calls recheck them before
   mutation. The returned child is retained as an exact Render_encoder handle. */
static bool prismel_parallel_store_action(int action){return action>=0&&action<=5;}
static bool prismel_parallel_store_options(int64_t options){return options>=0&&(options&~(int64_t)MTLStoreActionOptionCustomSamplePositions)==0;}
extern "C" CAMLprim value caml_prismel_metal_parallel_render_child(value raw,value active_raw){CAMLparam2(raw,active_raw);CAMLlocal3(tuple,handle,device);if(!Bool_val(active_raw))CAMLreturn(result_error_text("parallel render encoder has ended"));@try{id<MTLParallelRenderCommandEncoder>parent=object_of_handle(raw,Handle_kind::Parallel_render_encoder);id<MTLRenderCommandEncoder>child=[parent renderCommandEncoder];if(!child)CAMLreturn(result_error_text("Metal returned no parallel child encoder"));handle=allocate_handle(child,Handle_kind::Render_encoder);device=caml_copy_int64(child.device.registryID);tuple=caml_alloc_tuple(2);Store_field(tuple,0,handle);Store_field(tuple,1,device);CAMLreturn(result_ok(tuple));}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
/* target: 0 color action, 1 color options, 2 depth action, 3 depth options,
   4 stencil action, 5 stencil options. */
extern "C" CAMLprim value caml_prismel_metal_parallel_render_store(value raw,value target_raw,value value_raw,value index_raw,value active_raw,value open_children_raw){CAMLparam5(raw,target_raw,value_raw,index_raw,active_raw);CAMLxparam1(open_children_raw);if(!Bool_val(active_raw))CAMLreturn(result_error_text("parallel render encoder has ended"));if(Int64_val(open_children_raw)<0)CAMLreturn(result_error_text("invalid parallel child count"));int target=Long_val(target_raw);int64_t setting=Int64_val(value_raw),index=Int64_val(index_raw);bool options=target==1||target==3||target==5;if(target<0||target>5||(options?!prismel_parallel_store_options(setting):!prismel_parallel_store_action((int)setting)))CAMLreturn(result_error_text("invalid parallel render store state"));if((target==0||target==1)&&(index<0||index>=8))CAMLreturn(result_error_text("parallel color attachment index out of range"));@try{id<MTLParallelRenderCommandEncoder>parent=object_of_handle(raw,Handle_kind::Parallel_render_encoder);switch(target){case 0:[parent setColorStoreAction:(MTLStoreAction)setting atIndex:index];break;case 1:[parent setColorStoreActionOptions:(MTLStoreActionOptions)setting atIndex:index];break;case 2:[parent setDepthStoreAction:(MTLStoreAction)setting];break;case 3:[parent setDepthStoreActionOptions:(MTLStoreActionOptions)setting];break;case 4:[parent setStencilStoreAction:(MTLStoreAction)setting];break;case 5:[parent setStencilStoreActionOptions:(MTLStoreActionOptions)setting];break;}CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_parallel_render_store_bytecode(value*argv,int argc){(void)argc;return caml_prismel_metal_parallel_render_store(argv[0],argv[1],argv[2],argv[3],argv[4],argv[5]);}
