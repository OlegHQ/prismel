/* Exact typed callable shard for RasterizationRate55. Sizes are represented as
   OCaml int64 triples, coordinates as float pairs, and every object remains an
   exact Handle_kind rather than a nativeint escape hatch. */
static bool prismel_rate_size(value raw,MTLSize*out){int64_t w=Int64_val(Field(raw,0)),h=Int64_val(Field(raw,1)),d=Int64_val(Field(raw,2));if(w<0||h<0||d<0)return false;*out=MTLSizeMake(w,h,d);return true;}
static value prismel_rate_size_value(MTLSize s){CAMLparam0();CAMLlocal4(v,w,h,d);v=caml_alloc_tuple(3);w=caml_copy_int64(s.width);h=caml_copy_int64(s.height);d=caml_copy_int64(s.depth);Store_field(v,0,w);Store_field(v,1,h);Store_field(v,2,d);CAMLreturn(v);}
extern "C" CAMLprim value caml_prismel_metal_rate_layer_create(value size,value horizontal,value vertical){CAMLparam3(size,horizontal,vertical);CAMLlocal2(handle,result);MTLSize n;if(!prismel_rate_size(size,&n)||n.width==0||n.height==0||n.depth!=0||Wosize_val(horizontal)!=n.width||Wosize_val(vertical)!=n.height)CAMLreturn(result_error_text("invalid rasterization layer shape"));std::vector<float>h(n.width),v(n.height);for(NSUInteger i=0;i<n.width;i++){double x=Double_val(Field(horizontal,i));if(!std::isfinite(x)||x<0||x>1)CAMLreturn(result_error_text("horizontal rate sample out of range"));h[i]=x;}for(NSUInteger i=0;i<n.height;i++){double x=Double_val(Field(vertical,i));if(!std::isfinite(x)||x<0||x>1)CAMLreturn(result_error_text("vertical rate sample out of range"));v[i]=x;}@try{MTLRasterizationRateLayerDescriptor*d=[[MTLRasterizationRateLayerDescriptor alloc]initWithSampleCount:n horizontal:h.data() vertical:v.data()];handle=allocate_handle(d,Handle_kind::Raster_rate_layer);result=result_ok(handle);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_layer_snapshot(value raw){CAMLparam1(raw);CAMLlocal5(tuple,count,maximum,horizontal,vertical);@try{MTLRasterizationRateLayerDescriptor*d=object_of_handle(raw,Handle_kind::Raster_rate_layer);count=prismel_rate_size_value(d.sampleCount);maximum=prismel_rate_size_value(d.maxSampleCount);horizontal=caml_alloc(d.sampleCount.width,0);vertical=caml_alloc(d.sampleCount.height,0);for(NSUInteger i=0;i<d.sampleCount.width;i++)Store_field(horizontal,i,caml_copy_double(d.horizontalSampleStorage[i]));for(NSUInteger i=0;i<d.sampleCount.height;i++)Store_field(vertical,i,caml_copy_double(d.verticalSampleStorage[i]));tuple=caml_alloc_tuple(4);Store_field(tuple,0,count);Store_field(tuple,1,maximum);Store_field(tuple,2,horizontal);Store_field(tuple,3,vertical);CAMLreturn(result_ok(tuple));}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_layer_set_count(value raw,value size){CAMLparam2(raw,size);MTLSize n;if(!prismel_rate_size(size,&n)||n.depth!=0)CAMLreturn(result_error_text("invalid rasterization sample count"));@try{MTLRasterizationRateLayerDescriptor*d=object_of_handle(raw,Handle_kind::Raster_rate_layer);if(n.width>d.maxSampleCount.width||n.height>d.maxSampleCount.height)CAMLreturn(result_error_text("sample count exceeds maximum"));d.sampleCount=n;CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_sample(value raw,value vertical,value index,value set,value sample){CAMLparam5(raw,vertical,index,set,sample);CAMLlocal2(out,result);@try{MTLRasterizationRateLayerDescriptor*d=object_of_handle(raw,Handle_kind::Raster_rate_layer);NSUInteger i=Int64_val(index),limit=Bool_val(vertical)?d.sampleCount.height:d.sampleCount.width;if(i>=limit)CAMLreturn(result_error_text("rate sample index out of range"));MTLRasterizationRateSampleArray*a=Bool_val(vertical)?d.vertical:d.horizontal;if(Bool_val(set)){double x=Double_val(sample);if(!std::isfinite(x)||x<0||x>1)CAMLreturn(result_error_text("rate sample out of range"));a[i]=@(x);}out=caml_copy_double(a[i].doubleValue);result=result_ok(out);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_descriptor_create(value screen,value layers,value label){CAMLparam3(screen,layers,label);CAMLlocal2(handle,result);MTLSize size;if(!prismel_rate_size(screen,&size)||size.width==0||size.height==0)CAMLreturn(result_error_text("invalid rasterization screen size"));std::vector<MTLRasterizationRateLayerDescriptor*>items(Wosize_val(layers));for(mlsize_t i=0;i<Wosize_val(layers);i++)items[i]=object_of_handle(Field(layers,i),Handle_kind::Raster_rate_layer);@try{MTLRasterizationRateMapDescriptor*d=items.empty()?[MTLRasterizationRateMapDescriptor rasterizationRateMapDescriptorWithScreenSize:size]:items.size()==1?[MTLRasterizationRateMapDescriptor rasterizationRateMapDescriptorWithScreenSize:size layer:items[0]]:[MTLRasterizationRateMapDescriptor rasterizationRateMapDescriptorWithScreenSize:size layerCount:items.size() layers:items.data()];d.label=Is_none(label)?nil:string_from_ocaml(Field(label,0));handle=allocate_handle(d,Handle_kind::Raster_rate_descriptor);result=result_ok(handle);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_descriptor_snapshot(value raw){CAMLparam1(raw);CAMLlocal5(tuple,size,label,layers,item);@try{MTLRasterizationRateMapDescriptor*d=object_of_handle(raw,Handle_kind::Raster_rate_descriptor);size=prismel_rate_size_value(d.screenSize);label=copy_optional_string(d.label);layers=caml_alloc(d.layerCount,0);for(NSUInteger i=0;i<d.layerCount;i++){item=allocate_handle([d layerAtIndex:i],Handle_kind::Raster_rate_layer);Store_field(layers,i,item);}tuple=caml_alloc_tuple(3);Store_field(tuple,0,size);Store_field(tuple,1,label);Store_field(tuple,2,layers);CAMLreturn(result_ok(tuple));}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_descriptor_set(value raw,value screen,value label){CAMLparam3(raw,screen,label);MTLSize size;if(!prismel_rate_size(screen,&size)||size.width==0||size.height==0)CAMLreturn(result_error_text("invalid rasterization screen size"));@try{MTLRasterizationRateMapDescriptor*d=object_of_handle(raw,Handle_kind::Raster_rate_descriptor);d.screenSize=size;d.label=Is_none(label)?nil:string_from_ocaml(Field(label,0));CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_descriptor_layer(value raw,value index,value layer){CAMLparam3(raw,index,layer);CAMLlocal3(handle,option,result);@try{MTLRasterizationRateMapDescriptor*d=object_of_handle(raw,Handle_kind::Raster_rate_descriptor);NSUInteger i=Int64_val(index);[d setLayer:Is_none(layer)?nil:object_of_handle(Field(layer,0),Handle_kind::Raster_rate_layer) atIndex:i];MTLRasterizationRateLayerDescriptor*x=d.layers[i];if(!x)CAMLreturn(result_ok(Val_none));handle=allocate_handle(x,Handle_kind::Raster_rate_layer);option=caml_alloc(1,0);Store_field(option,0,handle);result=result_ok(option);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_map_create(value device,value descriptor){CAMLparam2(device,descriptor);CAMLlocal2(handle,result);@try{id<MTLDevice>d=object_of_handle(device,Handle_kind::Device);MTLRasterizationRateMapDescriptor*x=object_of_handle(descriptor,Handle_kind::Raster_rate_descriptor);id<MTLRasterizationRateMap>m=[d newRasterizationRateMapWithDescriptor:x];if(!m)CAMLreturn(result_error_text("Metal returned no rasterization rate map"));handle=allocate_handle(m,Handle_kind::Raster_rate_map);result=result_ok(handle);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_map_snapshot(value raw){CAMLparam1(raw);CAMLlocal5(tuple,screen,granularity,alignment,label);@try{id<MTLRasterizationRateMap>m=object_of_handle(raw,Handle_kind::Raster_rate_map);screen=prismel_rate_size_value(m.screenSize);granularity=prismel_rate_size_value(m.physicalGranularity);alignment=caml_alloc_tuple(2);Store_field(alignment,0,caml_copy_int64(m.parameterBufferSizeAndAlign.size));Store_field(alignment,1,caml_copy_int64(m.parameterBufferSizeAndAlign.align));label=copy_optional_string(m.label);tuple=caml_alloc_tuple(6);Store_field(tuple,0,screen);Store_field(tuple,1,granularity);Store_field(tuple,2,caml_copy_int64(m.layerCount));Store_field(tuple,3,alignment);Store_field(tuple,4,label);Store_field(tuple,5,caml_copy_int64(m.device.registryID));CAMLreturn(result_ok(tuple));}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_map_physical_size(value raw,value layer){CAMLparam2(raw,layer);CAMLlocal2(size,result);@try{id<MTLRasterizationRateMap>m=object_of_handle(raw,Handle_kind::Raster_rate_map);int64_t i=Int64_val(layer);if(i<0||(NSUInteger)i>=m.layerCount)CAMLreturn(result_error_text("rasterization layer index out of range"));size=prismel_rate_size_value([m physicalSizeForLayer:(NSUInteger)i]);result=result_ok(size);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_map_coordinate(value raw,value layer,value physical_to_screen,value point){CAMLparam4(raw,layer,physical_to_screen,point);CAMLlocal4(pair,x,y,result);@try{id<MTLRasterizationRateMap>m=object_of_handle(raw,Handle_kind::Raster_rate_map);int64_t i=Int64_val(layer);double px=Double_val(Field(point,0)),py=Double_val(Field(point,1));if(i<0||(NSUInteger)i>=m.layerCount||!std::isfinite(px)||!std::isfinite(py))CAMLreturn(result_error_text("invalid rasterization coordinate query"));MTLCoordinate2D p={static_cast<float>(px),static_cast<float>(py)};MTLCoordinate2D q=Bool_val(physical_to_screen)?[m mapPhysicalToScreenCoordinates:p forLayer:(NSUInteger)i]:[m mapScreenToPhysicalCoordinates:p forLayer:(NSUInteger)i];pair=caml_alloc_tuple(2);x=caml_copy_double(q.x);y=caml_copy_double(q.y);Store_field(pair,0,x);Store_field(pair,1,y);result=result_ok(pair);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_rate_map_copy_parameters(value raw,value buffer,value offset){CAMLparam3(raw,buffer,offset);@try{id<MTLRasterizationRateMap>m=object_of_handle(raw,Handle_kind::Raster_rate_map);id<MTLBuffer>b=object_of_handle(buffer,Handle_kind::Buffer);int64_t o=Int64_val(offset);MTLSizeAndAlign a=m.parameterBufferSizeAndAlign;if(o<0||(uint64_t)o>b.length||a.size>b.length-(NSUInteger)o||(a.align&&((NSUInteger)o%a.align)))CAMLreturn(result_error_text("rasterization parameter buffer range or alignment invalid"));[m copyParameterDataToBuffer:b offset:(NSUInteger)o];CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
