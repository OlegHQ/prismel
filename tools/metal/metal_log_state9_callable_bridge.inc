   and release the OCaml root only after all admitted callbacks have drained. */
struct PrismelLogHandlerState{std::shared_ptr<PrismelLogHandlerGate>gate=std::make_shared<PrismelLogHandlerGate>();value*root=nullptr;};
struct PrismelLogHandlerToken{std::shared_ptr<PrismelLogHandlerState>state;};
static void prismel_log_handler_fire(const std::shared_ptr<PrismelLogHandlerState>&state,NSString*subsystem,NSString*category,MTLLogLevel level,NSString*message){if(!state->gate->enter())return;int registered=caml_c_thread_register();caml_acquire_runtime_system();CAMLparam0();CAMLlocal5(payload,sub,cat,msg,outcome);sub=copy_optional_string(subsystem);cat=copy_optional_string(category);msg=caml_copy_string(message.UTF8String?message.UTF8String:"");payload=caml_alloc_tuple(4);Store_field(payload,0,sub);Store_field(payload,1,cat);Store_field(payload,2,Val_long(level));Store_field(payload,3,msg);outcome=caml_callback_exn(*state->root,payload);(void)outcome;CAMLdrop;caml_release_runtime_system();state->gate->leave();if(registered)caml_c_thread_unregister();}

extern "C" CAMLprim value caml_prismel_metal_log_state_descriptor_create(value level_raw,value size_raw){CAMLparam2(level_raw,size_raw);CAMLlocal2(handle,result);int level=Long_val(level_raw);int64_t size=Int64_val(size_raw);if(level<0||level>5||size<1024)CAMLreturn(result_error_text("invalid log-state level or buffer size"));if(@available(macOS 15.0,*)){@try{MTLLogStateDescriptor*descriptor=[MTLLogStateDescriptor new];descriptor.level=(MTLLogLevel)level;descriptor.bufferSize=(NSInteger)size;handle=allocate_handle(descriptor,Handle_kind::Log_state_descriptor);result=result_ok(handle);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal log states require macOS 15"));}
