extern "C" CAMLprim value caml_prismel_metal_log_state_create(value device_raw,value descriptor_raw){CAMLparam2(device_raw,descriptor_raw);CAMLlocal4(tuple,handle,registry,result);if(@available(macOS 15.0,*)){@try{id<MTLDevice>device=object_of_handle(device_raw,Handle_kind::Device);MTLLogStateDescriptor*descriptor=object_of_handle(descriptor_raw,Handle_kind::Log_state_descriptor);NSError*error=nil;id<MTLLogState>state=[device newLogStateWithDescriptor:descriptor error:&error];if(!state)CAMLreturn(result_error(error_description(error,@"Metal returned no log state")));PrismelMetalLogStateState*wrapper=[PrismelMetalLogStateState new];wrapper.state=state;wrapper.registryID=device.registryID;handle=allocate_handle(wrapper,Handle_kind::Log_state);registry=caml_copy_int64(wrapper.registryID);tuple=caml_alloc_tuple(2);Store_field(tuple,0,handle);Store_field(tuple,1,registry);result=result_ok(tuple);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal log states require macOS 15"));}
extern "C" CAMLprim value caml_prismel_metal_log_state_add_handler(value raw,value callback){CAMLparam2(raw,callback);CAMLlocal2(token,result);if(@available(macOS 15.0,*)){auto state=std::make_shared<PrismelLogHandlerState>();state->root=(value*)malloc(sizeof(value));if(!state->root)CAMLreturn(result_error_text("unable to root log handler"));*state->root=callback;caml_register_generational_global_root(state->root);PrismelLogHandlerToken*registration=nullptr;try{registration=new PrismelLogHandlerToken{state};}catch(...){caml_remove_generational_global_root(state->root);free(state->root);state->root=nullptr;CAMLreturn(result_error_text("unable to allocate log handler token"));}@try{PrismelMetalLogStateState*wrapper=object_of_handle(raw,Handle_kind::Log_state);id<MTLLogState>log=wrapper.state;[log addLogHandler:^(NSString*subsystem,NSString*category,MTLLogLevel level,NSString*message){prismel_log_handler_fire(state,subsystem,category,level,message);}];token=caml_copy_nativeint((intnat)registration);result=result_ok(token);CAMLreturn(result);}@catch(NSException*x){state->gate->cancel_and_wait();caml_remove_generational_global_root(state->root);free(state->root);state->root=nullptr;delete registration;CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal log states require macOS 15"));}
extern "C" CAMLprim value caml_prismel_metal_log_state_handler_cancel(value raw){CAMLparam1(raw);auto*token=(PrismelLogHandlerToken*)Nativeint_val(raw);if(token){caml_release_runtime_system();token->state->gate->cancel_and_wait();caml_acquire_runtime_system();if(token->state->root){caml_remove_generational_global_root(token->state->root);free(token->state->root);token->state->root=nullptr;}delete token;}CAMLreturn(Val_unit);}
