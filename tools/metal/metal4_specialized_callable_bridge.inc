/* Exact owned graph for all nine specialized-function method/property IDs. */
extern "C" CAMLprim value caml_prismel_metal4_function_descriptor(value rl,value rn){CAMLparam2(rl,rn);CAMLlocal2(raw,result);if(@available(macOS 26.0,*)){@try{id<MTLLibrary>l=object_of_handle(rl,Handle_kind::Library);NSString*n=string_from_ocaml(rn);if(!n||![l.functionNames containsObject:n])CAMLreturn(result_error_text("function is absent from library"));MTL4LibraryFunctionDescriptor*d=[MTL4LibraryFunctionDescriptor new];d.library=l;d.name=n;raw=allocate_handle(d,Handle_kind::Function_descriptor4);result=result_ok(raw);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal 4 requires macOS 26"));}
extern "C" CAMLprim value caml_prismel_metal4_function_constants(value unit){CAMLparam1(unit);CAMLlocal2(raw,result);if(@available(macOS 26.0,*)){raw=allocate_handle([MTLFunctionConstantValues new],Handle_kind::Function_constants4);result=result_ok(raw);CAMLreturn(result);}CAMLreturn(result_error_text("Metal 4 requires macOS 26"));}
extern "C" CAMLprim value caml_prismel_metal4_specialized_create(value rf,value rn,value rc){CAMLparam3(rf,rn,rc);CAMLlocal2(raw,result);if(@available(macOS 26.0,*)){@try{MTL4SpecializedFunctionDescriptor*d=[MTL4SpecializedFunctionDescriptor new];d.functionDescriptor=Is_block(rf)?object_of_handle(Field(rf,0),Handle_kind::Function_descriptor4):nil;d.specializedName=Is_block(rn)?string_from_ocaml(Field(rn,0)):nil;d.constantValues=Is_block(rc)?object_of_handle(Field(rc,0),Handle_kind::Function_constants4):nil;raw=allocate_handle(d,Handle_kind::Specialized_function_descriptor4);result=result_ok(raw);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal 4 requires macOS 26"));}
extern "C" CAMLprim value caml_prismel_metal4_specialized_get(value rd){CAMLparam1(rd);CAMLlocal5(v,o,h,n,result);if(@available(macOS 26.0,*)){@try{MTL4SpecializedFunctionDescriptor*d=object_of_handle(rd,Handle_kind::Specialized_function_descriptor4);v=caml_alloc_tuple(3);if(d.functionDescriptor){h=allocate_handle(d.functionDescriptor,Handle_kind::Function_descriptor4);o=caml_alloc(1,0);Store_field(o,0,h);}else o=Val_none;Store_field(v,0,o);n=copy_optional_string(d.specializedName);Store_field(v,1,n);if(d.constantValues){h=allocate_handle(d.constantValues,Handle_kind::Function_constants4);o=caml_alloc(1,0);Store_field(o,0,h);}else o=Val_none;Store_field(v,2,o);result=result_ok(v);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal 4 requires macOS 26"));}
extern "C" CAMLprim value caml_prismel_metal4_specialized_set(value rd,value rf,value rn,value rc){CAMLparam4(rd,rf,rn,rc);if(@available(macOS 26.0,*)){@try{MTL4SpecializedFunctionDescriptor*d=object_of_handle(rd,Handle_kind::Specialized_function_descriptor4);d.functionDescriptor=Is_block(rf)?object_of_handle(Field(rf,0),Handle_kind::Function_descriptor4):nil;d.specializedName=Is_block(rn)?string_from_ocaml(Field(rn,0)):nil;d.constantValues=Is_block(rc)?object_of_handle(Field(rc,0),Handle_kind::Function_constants4):nil;CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}CAMLreturn(result_error_text("Metal 4 requires macOS 26"));}
