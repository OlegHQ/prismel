/* CaptureManager21 tail. The process-global manager is serialized so a failed
   start rolls state back and two wrappers can never race into active capture. */
static std::mutex prismel_capture_mutex;static bool prismel_capture_active=false;
static id prismel_capture_object(value option,int tag){if(Is_none(option))return nil;value raw=Field(option,0);switch(tag){case 0:return object_of_handle(raw,Handle_kind::Device);case 1:return object_of_handle(raw,Handle_kind::Command_queue);case 2:return object_of_handle(raw,Handle_kind::Capture_scope);case 3:return object_of_handle(raw,Handle_kind::Command_queue4);default:return nil;}}
extern "C" CAMLprim value caml_prismel_metal_capture_descriptor_snapshot(value raw){CAMLparam1(raw);CAMLlocal5(tuple,object,url,destination,handle);@try{MTLCaptureDescriptor*d=object_of_handle(raw,Handle_kind::Capture_descriptor);if(!d.captureObject)object=Val_none;else{Handle_kind kind=[d.captureObject conformsToProtocol:@protocol(MTLDevice)]?Handle_kind::Device:[d.captureObject conformsToProtocol:@protocol(MTLCommandQueue)]?Handle_kind::Command_queue:Handle_kind::Capture_scope;handle=allocate_handle(d.captureObject,kind);object=caml_alloc(1,0);Store_field(object,0,handle);}url=copy_optional_string(d.outputURL.path);destination=Val_long(d.destination);tuple=caml_alloc_tuple(3);Store_field(tuple,0,object);Store_field(tuple,1,destination);Store_field(tuple,2,url);CAMLreturn(result_ok(tuple));}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_capture_descriptor_set(value raw,value object,value kind,value destination,value path){CAMLparam5(raw,object,kind,destination,path);int dest=Long_val(destination);if(dest!=1&&dest!=2)CAMLreturn(result_error_text("invalid capture destination"));NSString*p=Is_none(path)?nil:string_from_ocaml(Field(path,0));if((dest==2)!=(p!=nil))CAMLreturn(result_error_text("GPU trace destination requires exactly one output URL"));@try{MTLCaptureDescriptor*d=object_of_handle(raw,Handle_kind::Capture_descriptor);id captured=prismel_capture_object(object,Long_val(kind));if(Is_block(object)&&!captured)CAMLreturn(result_error_text("invalid capture object kind"));d.captureObject=captured;d.destination=(MTLCaptureDestination)dest;d.outputURL=p?[NSURL fileURLWithPath:p]:nil;CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_capture_scope_create(value manager,value object,value kind){CAMLparam3(manager,object,kind);CAMLlocal2(handle,result);@try{MTLCaptureManager*m=object_of_handle(manager,Handle_kind::Capture_manager);id<MTLCaptureScope>s=nil;if(Long_val(kind)==0)s=[m newCaptureScopeWithDevice:object_of_handle(object,Handle_kind::Device)];else if(Long_val(kind)==1)s=[m newCaptureScopeWithCommandQueue:object_of_handle(object,Handle_kind::Command_queue)];else if(Long_val(kind)==2){if(@available(macOS 26.0,*))s=[m newCaptureScopeWithMTL4CommandQueue:object_of_handle(object,Handle_kind::Command_queue4)];else CAMLreturn(result_error_text("Metal4 capture scopes require macOS 26"));}else CAMLreturn(result_error_text("invalid capture scope source"));if(!s)CAMLreturn(result_error_text("Metal returned no capture scope"));handle=allocate_handle(s,Handle_kind::Capture_scope);result=result_ok(handle);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_capture_default_scope(value manager,value scope,value set){CAMLparam3(manager,scope,set);CAMLlocal3(handle,option,result);@try{MTLCaptureManager*m=object_of_handle(manager,Handle_kind::Capture_manager);if(Bool_val(set))m.defaultCaptureScope=Is_none(scope)?nil:object_of_handle(Field(scope,0),Handle_kind::Capture_scope);id<MTLCaptureScope>s=m.defaultCaptureScope;if(!s)option=Val_none;else{handle=allocate_handle(s,Handle_kind::Capture_scope);option=caml_alloc(1,0);Store_field(option,0,handle);}result=result_ok(option);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wdeprecated-declarations"
extern "C" CAMLprim value caml_prismel_metal_capture_lifecycle(value manager,value object,value kind,value start){CAMLparam4(manager,object,kind,start);MTLCaptureManager*m=object_of_handle(manager,Handle_kind::Capture_manager);std::lock_guard<std::mutex>lock(prismel_capture_mutex);if(Bool_val(start)){if(prismel_capture_active||m.isCapturing)CAMLreturn(result_error_text("a Metal capture is already active"));@try{if(Long_val(kind)==0)[m startCaptureWithDevice:object_of_handle(object,Handle_kind::Device)];else if(Long_val(kind)==1)[m startCaptureWithCommandQueue:object_of_handle(object,Handle_kind::Command_queue)];else if(Long_val(kind)==2)[m startCaptureWithScope:object_of_handle(object,Handle_kind::Capture_scope)];else CAMLreturn(result_error_text("invalid capture start source"));prismel_capture_active=true;CAMLreturn(result_unit());}@catch(NSException*x){prismel_capture_active=false;CAMLreturn(result_error(x.reason));}}@try{if(prismel_capture_active||m.isCapturing)[m stopCapture];prismel_capture_active=false;CAMLreturn(result_unit());}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
#pragma clang diagnostic pop
extern "C" CAMLprim value caml_prismel_metal_capture_start_descriptor_checked(value manager,value descriptor){CAMLparam2(manager,descriptor);MTLCaptureManager*m=object_of_handle(manager,Handle_kind::Capture_manager);std::lock_guard<std::mutex>lock(prismel_capture_mutex);if(prismel_capture_active||m.isCapturing)CAMLreturn(result_error_text("a Metal capture is already active"));@try{NSError*e=nil;if(![m startCaptureWithDescriptor:object_of_handle(descriptor,Handle_kind::Capture_descriptor) error:&e]){prismel_capture_active=false;CAMLreturn(result_error(error_description(e,@"Metal capture failed")));}prismel_capture_active=true;CAMLreturn(result_unit());}@catch(NSException*x){prismel_capture_active=false;CAMLreturn(result_error(x.reason));}}
