/* Event14 isolated shard. Integration adds Shared_event_listener,
   Shared_event_handle, and Dispatch_queue exact handle kinds. Callback tokens
   are private raw values and use bounded exactly-once/cancellable roots. */
struct PrismelEventCallbackState{std::atomic<int>state{0};value*root=nullptr;};
struct PrismelEventCallbackToken{std::shared_ptr<PrismelEventCallbackState>state;};
static void prismel_event_callback_fire(const std::shared_ptr<PrismelEventCallbackState>&state,uint64_t number){int expected=0;if(!state->state.compare_exchange_strong(expected,1))return;int registered=caml_c_thread_register();caml_acquire_runtime_system();CAMLparam0();CAMLlocal1(v);v=caml_copy_int64(number);caml_callback_exn(*state->root,v);caml_remove_generational_global_root(state->root);free(state->root);state->root=nullptr;CAMLdrop;caml_release_runtime_system();if(registered)caml_c_thread_unregister();}

extern "C" CAMLprim value caml_prismel_metal_event_listener_create(value mode_raw,value label_option){CAMLparam2(mode_raw,label_option);CAMLlocal2(handle,result);@try{MTLSharedEventListener*listener=nil;switch(Long_val(mode_raw)){case 0:listener=[MTLSharedEventListener sharedListener];break;case 1:listener=[[MTLSharedEventListener alloc]init];break;case 2:{if(Is_none(label_option))CAMLreturn(result_error_text("custom event listener queue label is required"));NSString*label=string_from_ocaml(Field(label_option,0));if(!label)CAMLreturn(result_error_text("event listener queue label is not valid UTF-8"));dispatch_queue_t queue=dispatch_queue_create(label.UTF8String,DISPATCH_QUEUE_SERIAL);listener=[[MTLSharedEventListener alloc]initWithDispatchQueue:queue];break;}default:CAMLreturn(result_error_text("unknown event listener constructor"));}if(!listener)CAMLreturn(result_error_text("Metal returned no shared event listener"));handle=allocate_handle(listener,Handle_kind::Shared_event_listener);result=result_ok(handle);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}

extern "C" CAMLprim value caml_prismel_metal_event_listener_queue(value raw){CAMLparam1(raw);CAMLlocal4(tuple,handle,label,result);@try{MTLSharedEventListener*listener=object_of_handle(raw,Handle_kind::Shared_event_listener);dispatch_queue_t queue=listener.dispatchQueue;handle=allocate_handle((id)queue,Handle_kind::Dispatch_queue);const char*text=dispatch_queue_get_label(queue);label=caml_copy_string(text?text:"");tuple=caml_alloc_tuple(2);Store_field(tuple,0,handle);Store_field(tuple,1,label);result=result_ok(tuple);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}

extern "C" CAMLprim value caml_prismel_metal_shared_event_export_handle(value raw){CAMLparam1(raw);CAMLlocal2(handle,result);@try{id<MTLSharedEvent>event=object_of_handle(raw,Handle_kind::Shared_event);MTLSharedEventHandle*exported=[event newSharedEventHandle];if(!exported)CAMLreturn(result_error_text("Metal returned no shared event handle"));handle=allocate_handle(exported,Handle_kind::Shared_event_handle);result=result_ok(handle);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_shared_event_handle_label(value raw){CAMLparam1(raw);CAMLlocal2(label,result);@try{MTLSharedEventHandle*handle=object_of_handle(raw,Handle_kind::Shared_event_handle);label=copy_optional_string(handle.label);result=result_ok(label);CAMLreturn(result);}@catch(NSException*x){CAMLreturn(result_error(x.reason));}}

extern "C" CAMLprim value caml_prismel_metal_shared_event_notify(value event_raw,value listener_raw,value threshold_raw,value callback){CAMLparam4(event_raw,listener_raw,threshold_raw,callback);CAMLlocal2(token,result);int64_t threshold=Int64_val(threshold_raw);if(threshold<0)CAMLreturn(result_error_text("shared event threshold must be non-negative"));auto state=std::make_shared<PrismelEventCallbackState>();state->root=(value*)malloc(sizeof(value));if(!state->root)CAMLreturn(result_error_text("unable to root shared event callback"));*state->root=callback;caml_register_generational_global_root(state->root);PrismelEventCallbackToken*registration=nullptr;try{registration=new PrismelEventCallbackToken{state};}catch(...){caml_remove_generational_global_root(state->root);free(state->root);state->root=nullptr;CAMLreturn(result_error_text("unable to allocate shared event callback token"));}@try{id<MTLSharedEvent>event=object_of_handle(event_raw,Handle_kind::Shared_event);MTLSharedEventListener*listener=object_of_handle(listener_raw,Handle_kind::Shared_event_listener);[event notifyListener:listener atValue:(uint64_t)threshold block:^(id<MTLSharedEvent>,uint64_t value){prismel_event_callback_fire(state,value);}];token=caml_copy_nativeint((intnat)registration);result=result_ok(token);CAMLreturn(result);}@catch(NSException*x){int expected=0;if(state->state.compare_exchange_strong(expected,2)){caml_remove_generational_global_root(state->root);free(state->root);state->root=nullptr;}delete registration;CAMLreturn(result_error(x.reason));}}
extern "C" CAMLprim value caml_prismel_metal_shared_event_notify_cancel(value raw){CAMLparam1(raw);auto*token=(PrismelEventCallbackToken*)Nativeint_val(raw);if(token){int expected=0;if(token->state->state.compare_exchange_strong(expected,2)){caml_remove_generational_global_root(token->state->root);free(token->state->root);token->state->root=nullptr;}delete token;}CAMLreturn(Val_unit);}
