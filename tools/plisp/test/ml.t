  $ cat > a.rays <<'X'
  > (workspace a
  >   ; kept verbatim
  >   (graph g :context sop (sop/box)))
  > X
  $ rays-plisp ml a.rays
  (* generated by rays-plisp from a.rays; do not edit *)
  let () =
    Rays_editor.Workspace.main
      ~path:"a.rays"
