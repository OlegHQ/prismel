(executable
 (name r12_final_facade_stability)
 (libraries prismel_next_api unix yojson))

(executable
 (name validate_r12_final_facade_stability)
 (libraries yojson))

(test
 (name test_r12_validator)
 (libraries unix yojson)
 (deps validate_r12_final_facade_stability.exe)
 (action (run %{test} ./%{dep:validate_r12_final_facade_stability.exe})))

(rule
 (alias runtest)
 (action
  (progn
   (run %{exe:r12_final_facade_stability.exe} --scenario all
    --frames 600 --sample-every 0.01 --report r12-native-smoke.json)
   (run %{exe:validate_r12_final_facade_stability.exe} --allow-smoke
    r12-native-smoke.json))))
