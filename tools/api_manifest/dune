(library
 (name tool_support)
 (wrapped false)
 (modules support)
 (libraries digestif unix yojson))

(executable
 (name api_manifest)
 (modules api_manifest)
 (libraries tool_support))

(test
 (name test_sdl3_no_dynamic_ffi)
 (modules test_sdl3_no_dynamic_ffi)
 (libraries unix)
 (action (chdir %{workspace_root} (run %{test}))))

; Public API manifest: a change shows as a diff in runtest; accept it with
; `dune promote`.
(rule
 (targets api_stable.gen.json)
 (deps (glob_files_rec ../../lib/*.mli)
  (glob_files_rec ../../lib/dune))
 (action
  (with-stdout-to %{targets}
   (run %{exe:api_manifest.exe} --print %{workspace_root}))))

(rule
 (alias runtest)
 (action (diff api_stable.json api_stable.gen.json)))
