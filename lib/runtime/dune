(library
 (name runtime)
 (public_name rays.runtime)
 (modules runtime runtime_shaders)
 (private_modules runtime_shaders)
 (libraries sdl3 ogpu scene_execution))

(library
 (name runtime_input)
 (public_name rays.runtime_input)
 (wrapped false)
 (modules runtime_input runtime_input_sdl3)
 (libraries sdl3))

(executable
 (name test_main)
 (modules test_main test_runtime test_runtime_visibility test_runtime_scaling test_runtime_scene3_lighting test_runtime_scene3_instances test_runtime_scene2_argument test_runtime_input)
 (libraries runtime runtime_input scene_execution ogpu sdl3))

