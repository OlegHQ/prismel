(library
 (name scene_execution)
 (public_name prismel.scene_execution)
 (modules scene_execution scene_attachment_pool)
 (private_modules scene_attachment_pool)
 (libraries ogpu))

(executable
 (name test_main)
 (modules test_main test_prepared_scene3 test_automatic_scratch test_retained_eviction test_offscreen_metal)
 (libraries scene_execution scene_execution_fixtures ogpu))

; Minimal per-family MSL pipelines for tests and benchmarks that drive the
; renderer on a real device.
(library
 (name scene_execution_fixtures)
 (modules scene_execution_fixtures)
 (libraries scene_execution ogpu))

(rule
 (aliases runtest test_prepared_scene3)
 (action (run %{exe:test_main.exe} test_prepared_scene3)))

