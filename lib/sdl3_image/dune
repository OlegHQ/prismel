(executable
 (name discover)
 (modules discover)
 (libraries sdl3_discovery))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (action (run ./discover.exe)))

(library
 (name sdl3_image)
 (public_name prismel.sdl3_image)
 (modules Sdl3_image Generated_provenance)
 (private_modules Generated_provenance)
 (foreign_stubs
  (language c)
  (names sdl3_image_stubs)
  (flags (:include c_flags.sexp)))
 (c_library_flags (:include c_library_flags.sexp))
 (libraries sdl3))

(test
 (name test_sdl3_image)
 (modules test_sdl3_image)
 (libraries sdl3 sdl3_image)
 (deps (source_tree ../../test/sdl3_image_fixtures))
 (action
  (setenv SDL_VIDEODRIVER dummy
   (run %{test} %{workspace_root}/test/sdl3_image_fixtures))))

(rule
 (alias runtest)
 (deps generated_provenance.ml generated_inventory.json generated_abi.h)
 (action
  (run %{exe:../../tools/sdl3/generate.exe} --root %{workspace_root}
   --extension image --check)))
