(executable
 (name discover)
 (modules discover)
 (libraries sdl3_discovery))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (action (run ./discover.exe)))

(library
 (name sdl3_mixer)
 (public_name prismel.sdl3_mixer)
 (modules Sdl3_mixer Generated_provenance)
 (private_modules Generated_provenance)
 (foreign_stubs
  (language c)
  (names sdl3_mixer_stubs)
  (flags (:include c_flags.sexp)))
 (c_library_flags (:include c_library_flags.sexp))
 (libraries sdl3 threads))

(executable
 (name test_main)
 (modules test_main test_sdl3_mixer test_sdl3_mixer_device_failure)
 (libraries sdl3 sdl3_mixer))

(rule
 (aliases runtest test_sdl3_mixer)
 (action
  (setenv SDL_AUDIODRIVER dummy
   (run %{exe:test_main.exe} test_sdl3_mixer))))

(rule
 (aliases runtest test_sdl3_mixer_device_failure)
 (action
  (setenv SDL_AUDIODRIVER prismel_missing_audio_driver
   (run %{exe:test_main.exe} test_sdl3_mixer_device_failure))))

(rule
 (alias qualification)
 (deps generated_provenance.ml generated_inventory.json generated_abi.h)
 (action
  (run %{exe:../../tools/sdl3/generate.exe} --root %{workspace_root}
   --extension mixer --check)))
