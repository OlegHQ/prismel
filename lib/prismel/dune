(library
 (name prismel)
 (public_name prismel)
 (modules vec2 vec3 bounds2 bounds3 color math mat3 mat4 quat rand noise light material
  node3 path parallel texture input event input_state frame time clipboard image
  canvas canvas_runtime font audio assets mesh camera easy_camera shadow3
  scene3 scene3_native_lowering
  scene native_scene_lowering ink sketch easy_camera2)
 (private_modules input_state canvas_runtime scene3_native_lowering native_scene_lowering)
 (libraries prismel_math domainslib lru runtime_resources runtime_input runtime scene_command unix
  prismel_execution))

(executable
 (name test_main)
 (modules test_main test_prismel_api test_prismel_api_batch_d test_prismel_api_batch_a test_prismel_api_batch_b test_prismel_api_batch_c test_prismel_api_batch_c_scene_parity test_scene_rounded_cache test_automatic_text_cache test_prismel_api_batch_e test_scene3_native_lowering test_scene_display_list test_ink test_core_interface_preservation test_resource_interface_preservation test_canvas_native)
 (libraries prismel runtime_resources runtime_input scene_command unix ogpu))

(rule
 (aliases runtest test_prismel_api)
 (action (run %{exe:test_main.exe} test_prismel_api)))

