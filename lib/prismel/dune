(library
 (name prismel)
 (public_name prismel)
 (modules vec2 vec3 color math mat3 mat4 quat rand noise fog3 light material
  node3 path parallel texture shader3 compute3 input event frame time image
  canvas canvas_runtime font audio assets mesh camera easy_camera transform_feedback3 shadow3
  scene3 scene3_native_lowering
  scene native_scene_lowering preview runtime_diagnostics sketch easy_camera2)
 (private_modules canvas_runtime scene3_native_lowering native_scene_lowering)
 (libraries domainslib prismel_next_resources runtime_next_input scene_command unix
  prismel_next_execution
  runtime_next_orchestrator))

; Transitional module identity for native-only validation clients. It
; re-exports the promoted facade and owns no renderer implementation.
(library
 (name prismel_next_api)
 (public_name prismel.prismel_next_api)
 (wrapped false)
 (modules prismel_next_api)
 (libraries prismel))

(executable
 (name test_main)
 (modules test_main test_prismel_next_api test_prismel_next_api_batch_d test_prismel_next_api_batch_a test_prismel_next_api_batch_b test_prismel_next_api_batch_c test_prismel_next_api_batch_c_scene_parity test_scene_rounded_cache test_automatic_text_cache test_prismel_next_api_batch_e test_scene3_native_lowering test_scene_display_list test_core_interface_preservation test_resource_interface_preservation test_canvas_native)
 (libraries prismel prismel_next_resources runtime_next_input scene_command unix metal))

(rule
 (aliases runtest test_prismel_next_api)
 (action (run %{exe:test_main.exe} test_prismel_next_api)))

