(rule
 (targets (dir metal_xpc_conformance.app))
 (deps test_metal_xpc_client.exe test_metal_xpc_service.exe)
 (action
  (run ./build_xpc_bundle.exe
   --client test_metal_xpc_client.exe
   --service test_metal_xpc_service.exe
   --output metal_xpc_conformance.app
   --service-name org.prismel.metal.xpc-conformance)))

