(library
 (name metal_build_config)
 (wrapped false)
 (modules Metal_build_config))

(executable
 (name discover)
 (modules discover)
 (libraries metal_build_config))

(executable
 (name build_bridge)
 (modules build_bridge)
 (libraries metal_build_config unix))

(rule
 (targets c_library_flags.sexp)
 (action
  (run ./discover.exe --sanitizers %{env:PRISMEL_METAL_SANITIZERS=}
   --output %{targets})))

(rule
 (targets metal_bridge.o libmetal_bridge_stubs.a dllmetal_bridge_stubs.so)
 (deps metal_bridge.mm c_library_flags.sexp)
 (action
  (run ./build_bridge.exe
   --sanitizers %{env:PRISMEL_METAL_SANITIZERS=}
   --profile %{profile}
   --ocaml-include %{ocaml-config:standard_library}
   --source %{dep:metal_bridge.mm}
   --object metal_bridge.o
   --archive libmetal_bridge_stubs.a
   --shared dllmetal_bridge_stubs.so)))

(library
 (name metal)
 (public_name prismel.metal)
 (modules Metal Metal_raw Generated_provenance)
 (private_modules Metal_raw Generated_provenance)
 (foreign_archives metal_bridge_stubs)
 (c_library_flags (:include c_library_flags.sexp)))

(test
 (name test_metal_build_config)
 (modules test_metal_build_config)
 (libraries metal_build_config))

(test
 (name test_metal)
 (modules test_metal)
 (libraries metal))

(test
 (name test_metal_stress)
 (modules test_metal_stress)
 (libraries metal))

(rule
 (alias runtest)
 (deps generated_api_inventory.json generated_provenance.ml)
 (action
  (run %{exe:../../tools/metal/generate_inventory.exe}
   --root %{workspace_root} --check)))
