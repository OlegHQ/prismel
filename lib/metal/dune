(rule
 (targets metal_bridge.o libmetal_bridge_stubs.a dllmetal_bridge_stubs.so)
 (deps metal_bridge.mm)
 (action
  (progn
   (run clang++ -x objective-c++ -std=c++17 -fobjc-arc -fblocks
    -mmacosx-version-min=14.0 -Wall -Wextra -Werror
   -I %{ocaml-config:standard_library} -c %{dep:metal_bridge.mm}
    -o metal_bridge.o)
   (run ar rcs libmetal_bridge_stubs.a metal_bridge.o)
   (run clang++ -dynamiclib -undefined dynamic_lookup
    -mmacosx-version-min=14.0 metal_bridge.o -framework Foundation
    -framework Metal -framework QuartzCore
    -o dllmetal_bridge_stubs.so))))

(library
 (name metal)
 (public_name prismel.metal)
 (modules Metal Metal_raw Generated_provenance)
 (private_modules Metal_raw Generated_provenance)
 (foreign_archives metal_bridge_stubs)
 (c_library_flags -framework Foundation -framework Metal -framework QuartzCore
  -lc++))

(test
 (name test_metal)
 (modules test_metal)
 (libraries metal))

(test
 (name test_metal_stress)
 (modules test_metal_stress)
 (libraries metal))

(rule
 (alias runtest)
 (deps generated_api_inventory.json generated_provenance.ml)
 (action
  (run %{exe:../../tools/metal/generate_inventory.exe}
   --root %{workspace_root} --check)))
