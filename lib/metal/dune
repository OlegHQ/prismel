   --output-manifest generated_binding_manifest.json
   --output-public-enum-ml metal_enum_generated.ml
   --output-public-enum-mli metal_enum_generated.mli
   --output-public-enum-test test_metal_enum_generated.ml
   --output-public-value-ml metal_value_record_generated.ml
   --output-public-value-mli metal_value_record_generated.mli
   --output-public-value-test test_metal_value_record_generated.ml)))

(rule
 (targets metal_bridge.o libmetal_bridge_stubs.a dllmetal_bridge_stubs.so)
 (deps metal_bridge.mm metal_bridge_generated.inc c_library_flags.sexp)
 (action
  (run ./build_bridge.exe
   --sanitizers %{env:PRISMEL_METAL_SANITIZERS=}
   --profile %{profile}
   --ocaml-include %{ocaml-config:standard_library}
   --source %{dep:metal_bridge.mm}
   --object metal_bridge.o
   --archive libmetal_bridge_stubs.a
   --shared dllmetal_bridge_stubs.so)))

(library
