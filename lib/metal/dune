   --plan-root %{workspace_root}
   --generator-source %{dep:../../tools/metal/generate_bindings.ml}
   --manual-native %{dep:metal_bridge.mm}
   --manual-raw-ml %{dep:metal_raw.ml}
   --manual-raw-mli %{dep:metal_raw.mli}
   --safe-source %{dep:metal.ml}
   --safe-tests %{dep:test_metal.ml}
   --output-raw-ml metal_raw_generated.ml
   --output-raw-mli metal_raw_generated.mli
