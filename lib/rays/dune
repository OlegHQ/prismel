 (libraries rays_math domainslib lru runtime_resources runtime_input runtime scene_command unix
  rays_execution))

(executable
 (name test_main)
 (modules test_main test_scene_rounded_cache test_automatic_text_cache test_scene3_float32 test_scene_display_list test_ink test_canvas_native test_world)
 (libraries rays runtime runtime_resources runtime_input scene_command scene_execution unix ogpu threads))

