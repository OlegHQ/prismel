(library
 (name rays)
 (public_name rays)
 (modules vec2 vec3 bounds2 color mat4 quat rand noise light material
  path parallel texture input event input_state frame time clipboard image
  canvas canvas_runtime font audio mesh camera easy_camera shadow3
  scene3 scene3_native_lowering
  scene native_scene_lowering ink sketch world)
 (private_modules input_state time canvas_runtime scene3_native_lowering native_scene_lowering)
 (libraries rays_math domainslib lru runtime_resources runtime_input runtime scene_command unix
  rays_execution))

(executable
 (name test_shape_batch)
 (modules test_shape_batch)
 (libraries rays scene_command))

(rule
 (aliases runtest test_shape_batch)
 (action (run %{exe:test_shape_batch.exe})))

(rule
 (aliases runtest-native test_shape_batch_native)
 (locks smoke_window)
 (action (run %{exe:test_shape_batch.exe} native)))

