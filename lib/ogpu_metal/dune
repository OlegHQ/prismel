(rule
 (alias offline_shader_artifacts)
 (targets offline_parity.air offline_parity.metallib offline_parity.metadata)
 (deps offline_parity.metal ../../tools/gpu_migration/metal_shader_artifact.exe)
 (action
  (run ../../tools/gpu_migration/metal_shader_artifact.exe
   --source %{dep:offline_parity.metal} --air offline_parity.air
   --metallib offline_parity.metallib
   --metadata offline_parity.metadata --deployment 13.0)))
