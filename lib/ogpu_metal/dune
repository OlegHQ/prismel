 (name test_main)
 (modules test_main test_ogpu_metal_foundation test_ogpu_metal_texture test_ogpu_metal_pipeline test_ogpu_metal_surface test_ogpu_metal_sync test_ogpu_metal_memory test_ogpu_metal_acceleration test_ogpu_metal_diagnostics test_ogpu_metal_capabilities test_ogpu_metal_sampler_pixels test_scene_execution_metal test_pipeline_argument_buffer)
 (libraries scene_execution ogpu_metal_native metal unix))

