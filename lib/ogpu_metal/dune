(library
 (name ogpu_metal_native)
 (public_name prismel.ogpu_metal_native)
 (modules Device Buffer Texture Sampler Library Pipeline Queue Presentation Surface Sync Memory Acceleration Diagnostics Backend)
 (private_modules Presentation)
 (libraries ogpu_core metal))

(library
 (name ogpu_metal)
 (public_name prismel.ogpu_metal)
 (implements ogpu)
 (modules Impl)
 (libraries ogpu_metal_native metal))

