(executable
 (name discover)
 (modules discover)
 (libraries sdl3_discovery))

(rule
 (targets c_flags.sexp c_library_flags.sexp sdl3_probed.h)
 (deps (universe))
 (action (run ./discover.exe)))

(rule
 (targets generated_abi.h)
 (deps
  ../../packaging/sdl3.lock
  ../sdl3/abi.sexp
  ../sdl3/sdl3_stubs.c
  ../sdl3/sdl3_dialog.c
  ../sdl3_image/sdl3_image_stubs.c
  ../sdl3_ttf/sdl3_ttf_stubs.c
  ../sdl3_mixer/sdl3_mixer_stubs.c)
 (action
  (run %{exe:../../tools/sdl3/generate.exe} emit --root ../..
   --component sdl3 --lock ../../packaging/sdl3.lock
   --abi ../sdl3/abi.sexp --output generated_abi.h)))

(library
 (name sdl3)
 (public_name rays.sdl3)
 (modules Sdl3 Private_raw)
 (private_modules Private_raw)
 (foreign_stubs
  (language c)
  (names sdl3_stubs sdl3_dialog sdl3_cocoa)
  (flags (:include c_flags.sexp) -Wall -Wextra -Werror)
  (extra_deps generated_abi.h sdl3_probed.h sdl3_dialog.h sdl3_cocoa.h))
 (c_library_flags (:include c_library_flags.sexp) -lobjc)
 (libraries threads native_layer_token))

(executable
 (name test_main)
 (modules test_main test_sdl3 test_sdl3_metal test_sdl3_stress test_sdl3_failure test_sdl3_events)
 (libraries sdl3 sdl3_lock)
 (link_flags (-ccopt "-framework ApplicationServices"))
 (foreign_stubs
  (language c)
  (names test_sdl3_events_stubs)
  (flags (:include c_flags.sexp))))

(rule
 (aliases runtest test_sdl3)
 (deps ../../packaging/sdl3.lock)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_sdl3))))

(rule
 (aliases runtest-native test_sdl3_metal)
 (locks smoke_window)
 (action (run %{exe:test_main.exe} test_sdl3_metal)))

(rule
 (aliases runtest test_sdl3_stress)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_sdl3_stress))))

(rule
 (aliases runtest test_sdl3_failure)
 (action (setenv SDL_VIDEODRIVER rays_missing_video_driver
  (run %{exe:test_main.exe} test_sdl3_failure))))

(rule
 (aliases runtest test_sdl3_events)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_sdl3_events))))

(rule
 (alias qualification)
 (locks smoke_window)
 (action
  (setenv SDL_VIDEODRIVER dummy
   (setenv RAYS_SDL3_STRESS_CYCLES 100000
    (run %{exe:test_main.exe} test_sdl3_stress)))))
