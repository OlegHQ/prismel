(executable
 (name discover)
 (modules discover)
 (libraries sdl3_discovery))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (action (run ./discover.exe)))

(library
 (name sdl3)
 (public_name prismel.sdl3)
 (modules Sdl3 Private_raw Generated_provenance)
 (private_modules Private_raw Generated_provenance)
 (foreign_stubs
  (language c)
  (names sdl3_stubs)
  (flags (:include c_flags.sexp)))
 (c_library_flags (:include c_library_flags.sexp))
 (libraries threads native_layer_token))

(executable
 (name test_main)
 (modules test_main test_sdl3 test_sdl3_metal test_sdl3_stress test_sdl3_failure test_sdl3_events)
 (libraries sdl3)
 (foreign_stubs
  (language c)
  (names test_sdl3_events_stubs)
  (flags (:include c_flags.sexp))))

(rule
 (aliases runtest test_sdl3)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_sdl3))))

(rule
 (aliases runtest-native test_sdl3_metal)
 (action (run %{exe:test_main.exe} test_sdl3_metal)))

(rule
 (aliases runtest test_sdl3_stress)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_sdl3_stress))))

(rule
 (aliases runtest test_sdl3_failure)
 (action (setenv SDL_VIDEODRIVER prismel_missing_video_driver
  (run %{exe:test_main.exe} test_sdl3_failure))))

(rule
 (aliases runtest test_sdl3_events)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_sdl3_events))))

(rule
 (alias qualification)
 (action
  (setenv SDL_VIDEODRIVER dummy
   (setenv PRISMEL_SDL3_STRESS_CYCLES 100000
    (run %{exe:test_main.exe} test_sdl3_stress)))))

(rule
 (alias qualification)
 (deps generated_provenance.ml generated_inventory.json generated_layout.json
  generated_abi.h)
 (action
  (run %{exe:../../tools/sdl3/generate.exe} --root %{workspace_root}
   --extension core --check)))
