(library
 (name pxui)
 (public_name prismel.pxui)
 (modules pxui theme ui settings camera_controls)
 (libraries prismel scene_command))

(executable
 (name test_main)
 (modules test_main test_pxui_undo test_ui_parity test_ui)
 (libraries prismel pxui scene_command sdl3))

(rule
 (aliases runtest test_pxui_undo)
 (action (run %{exe:test_main.exe} test_pxui_undo)))

(rule
 (aliases runtest-native test_ui_parity)
 (deps fixtures/kit_panel_2x.png fixtures/kit_overlays_2x.png)
 (action
  (setenv PRISMEL_UI_FONT %{dep:../../assets/fonts/DepartureMono-Regular.otf}
   (run %{exe:test_main.exe} test_ui_parity))))

(rule
 (aliases runtest test_ui)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_ui))))
