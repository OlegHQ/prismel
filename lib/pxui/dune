(library
 (name pxui)
 (public_name rays.pxui)
 (modules pxui theme ui camera_controls)
 (libraries rays))

(executable
 (name test_main)
 (modules test_main test_ui_parity test_ui test_input test_keyboard)
 (libraries rays pxui scene_command sdl3))

(rule
 (aliases runtest-native test_ui_parity)
 (locks smoke_window)
 (deps fixtures/kit_panel_2x.png fixtures/kit_overlays_2x.png fixtures/kit_zones_1x.png)
 (action
  (setenv RAYS_UI_FONT %{dep:../../assets/fonts/DepartureMono-Regular.otf}
   (run %{exe:test_main.exe} test_ui_parity))))

(rule
 (aliases runtest test_ui)
 ; pointer positions in the text tests assume the golden face's advance
 (action (setenv SDL_VIDEODRIVER dummy
  (setenv RAYS_UI_FONT %{dep:../../assets/fonts/DepartureMono-Regular.otf}
   (run %{exe:test_main.exe} test_ui)))))

(rule
 (aliases runtest test_input)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_input))))

(rule
 (aliases runtest test_keyboard)
 (action (setenv SDL_VIDEODRIVER dummy
  (run %{exe:test_main.exe} test_keyboard))))
