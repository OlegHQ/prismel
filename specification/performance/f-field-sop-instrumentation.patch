 (* ocamldep must see the PPX's [Procedural.X] resolve inside this library. *)
 module Procedural = Sop_support.Procedural

+module Field_profile = struct
+  let enabled = Sys.getenv_opt "RAYS_F_FIELD_PROFILE" = Some "1"
+  let trial = ref (-1)
+  let rows = ref []
+  let next () = let n = !trial in incr trial; n
+  let measure context trial phase body =
+    if not enabled then body () else
+    let before = Gc.stat () in
+    let started = Unix.gettimeofday () in
+    let result = body () in
+    let seconds = Unix.gettimeofday () -. started in
+    let after = Gc.stat () in
+    let bytes = float_of_int (Sys.word_size / 8) in
+    let promoted = (after.promoted_words -. before.promoted_words) *. bytes
+    and major = (after.major_words -. before.major_words) *. bytes in
+    let allocated = (after.minor_words -. before.minor_words) *. bytes +. major -. promoted in
+    rows := (Context.domains context, trial, phase, seconds, allocated, promoted, major) :: !rows;
+    result
+  let () = at_exit (fun () -> if enabled then begin
+    prerr_endline "domains,repetition,phase,seconds,allocated_bytes_all_domains,promoted_bytes,major_bytes";
+    List.iter (fun (domains, trial, phase, seconds, allocated, promoted, major) ->
+      Printf.eprintf "%d,%d,%s,%.9f,%.0f,%.0f,%.0f\n"
+        domains trial phase seconds allocated promoted major) (List.rev !rows)
+  end)
+end
+
