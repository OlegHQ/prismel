+  let trial = ref (-1)
+  let finish_started = ref 0.
+  let rows = ref []
+  let next () = let n = !trial in incr trial; n
+  let start () = if path = None then 0. else Unix.gettimeofday ()
+  let stop trial phase started =
+    let finished = start () in
+    if path <> None then rows := (trial, phase, finished -. started) :: !rows;
+    finished
+  let () = at_exit (fun () -> Option.iter (fun path ->
+    let output = open_out path in
+    Fun.protect ~finally:(fun () -> close_out output) (fun () ->
+      output_string output "domains,repetition,phase,seconds\n";
+      List.iter (fun (trial, phase, seconds) ->
+        Printf.fprintf output "%d,%d,%s,%.17g\n" domains trial phase seconds)
+        (List.rev !rows))) path)
+end
