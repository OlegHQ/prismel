+let merge_plain ?cancel ?grain ?pad_groups geometries =
+  if not (Domain.DLS.get phase_enabled) then merge_plain_impl ?cancel ?grain ?pad_groups geometries
+  else
+    let prior = Domain.DLS.get phase_current in
+    let sample = {stack=[];entries=[]} in
+    Domain.DLS.set phase_current (Some sample);
+    Fun.protect ~finally:(fun () -> Domain.DLS.set phase_current prior) (fun () ->
+      let started = Unix.gettimeofday () in
+      let result = phase "remaining_metadata_wrapping_groups_geometry_and_probe_bookkeeping"
+        (fun () -> merge_plain_impl ?cancel ?grain ?pad_groups geometries) in
+      let whole = Unix.gettimeofday () -. started in
+      assert (whole>=0.);
+      let buffered = Domain.DLS.get phase_buffer in
+      if List.length buffered>=8 then failwith "merge phase buffer overflow";
+      Domain.DLS.set phase_buffer ((whole,sample.entries)::buffered);
+      result)
+
+module Private = struct
+  let enable_phase_samples () =
+    assert (Domain.is_main_domain ()); Domain.DLS.set phase_enabled true
+  let take_phase_samples () =
+    let samples=List.rev(Domain.DLS.get phase_buffer) in
+    Domain.DLS.set phase_buffer [];samples
+end
