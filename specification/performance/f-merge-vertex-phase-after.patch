+type scope = { mutable children : float }
+type phase_sample = { mutable stack : scope list; mutable entries : (string * int * float) list }
+let phase_enabled = Domain.DLS.new_key (fun () -> false)
+let phase_current = Domain.DLS.new_key (fun () -> None)
+let phase_buffer = Domain.DLS.new_key (fun () -> [])
+let phase name run = match Domain.DLS.get phase_current with
+  | None -> run ()
+  | Some sample ->
+      let started = Unix.gettimeofday () in
+      let parent = sample.stack and scope = {children=0.} in
+      sample.stack <- scope::parent;
+      Fun.protect run ~finally:(fun () ->
+        let elapsed = Unix.gettimeofday () -. started in
+        let exclusive = elapsed -. scope.children in
+        assert (elapsed>=0. && exclusive>=0.);
+        sample.stack <- parent;
+        (match parent with [] -> () | p::_ -> p.children<-p.children+.elapsed);
+        let calls,seconds = match List.find_opt(fun(n,_,_)->n=name)sample.entries with
+          | None -> 0,0. | Some(_,calls,seconds)->calls,seconds in
+        sample.entries <- (name,calls+1,seconds+.exclusive)
+          :: List.filter(fun(n,_,_)->n<>name)sample.entries)
+
