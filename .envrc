# Activate the repository-local switch regardless of the caller's current
# opam switch.
eval "$(opam env --switch=. --set-switch)"

# Export the repository's non-secret runtime defaults. Keeping SDL driver
# selection out of this file leaves that policy at Prismel's backend boundary.
if [ -r .env ]; then
  if command -v watch_file >/dev/null 2>&1; then
    watch_file .env
  fi
  set -a
  . ./.env
  set +a
fi
