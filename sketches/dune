; .plisp sketches: `dune build @runtest; dune promote` after adding one (plan W11)
(include dune.plisp.inc)

(rule
 (target dune.plisp.inc.gen)
 (deps
  (glob_files_rec sketch.plisp)
  (glob_files_rec dune))
 (action
  (with-stdout-to
   %{target}
   (run %{bin:prismel-plisp} dune .))))

(rule
 (alias runtest)
 (action
  (diff dune.plisp.inc dune.plisp.inc.gen)))
