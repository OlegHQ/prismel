; .rays sketches: `dune build @runtest; dune promote` after adding one (plan W11)
(include dune.rays.inc)

(rule
 (target dune.rays.inc.gen)
 (deps
  (glob_files_rec sketch.rays)
  (glob_files_rec dune))
 (action
  (with-stdout-to
   %{target}
   (run %{bin:rays-lisp} dune .))))

(rule
 (alias runtest)
 (action
  (diff dune.rays.inc dune.rays.inc.gen)))
