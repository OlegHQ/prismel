(rule
 (targets cases.ml)
 (deps ../../specification/workspace/cases/bloom.lisp
       ../../specification/workspace/cases/sunflower.lisp
       ../../specification/workspace/cases/orrery.lisp
       ../../specification/workspace/cases/rosette.lisp
       ../../specification/workspace/cases/variations.lisp
       garden.rays lamps.rays)
 (action
  (with-stdout-to cases.ml
   (progn
    (echo "let bloom = {|") (cat ../../specification/workspace/cases/bloom.lisp) (echo "|}\n")
    (echo "let sunflower = {|") (cat ../../specification/workspace/cases/sunflower.lisp) (echo "|}\n")
    (echo "let orrery = {|") (cat ../../specification/workspace/cases/orrery.lisp) (echo "|}\n")
    (echo "let rosette = {|") (cat ../../specification/workspace/cases/rosette.lisp) (echo "|}\n")
    (echo "let variations = {|") (cat ../../specification/workspace/cases/variations.lisp) (echo "|}\n")
    (echo "let garden = {|") (cat garden.rays) (echo "|}\n")
    (echo "let lamps = {|") (cat lamps.rays) (echo "|}\n")))))

(executable
 (name main)
 (modules main cases)
 (libraries rays procedural rdk rdk_rays sop_catalog flow flow_sop rays_editor))
