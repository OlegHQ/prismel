(rule
 (target sketch_source.ml)
 (deps sketch.rays)
 (action (chdir %{workspace_root}
  (with-stdout-to %{target} (run %{bin:rays-plisp} source %{dep:sketch.rays})))))

(executable
 (name main)
 (modules main sketch_source)
 (libraries rays procedural rdk rdk_rays sop_catalog sketch_support rays_editor))
