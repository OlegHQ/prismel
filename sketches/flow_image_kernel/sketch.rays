(workspace flow_image_kernel
  (graph image :context image
    (let* [bias (* 0.2 (+ 1 (sin t)))
           pixels (image/map (fn [uv] [(+ uv.x bias) uv.y 0.5 1])
                    :width 256 :height 256)]
      pixels))
  (graph picture :context draw
    (draw/image (ref image) :at [0 0 0]))
  (graph settings :context settings
    (settings/config :title "Flow image kernel" :width 900 :height 600))
  (graph editor :context editor
    (let* [preview (ui/canvas (ref picture))
           network (ui/graph "image" :focus true)
           inspector (ui/inspector :of network)]
      (ui/workspace (ui/split "horizontal"
        (ui/split "vertical" preview network :second_size 264)
        inspector :second_size 240)))))
