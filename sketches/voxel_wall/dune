(rule
 (target sketch_source.ml)
 (deps sketch.rays)
 (action (chdir %{workspace_root}
  (with-stdout-to %{target} (run %{bin:rays-lisp} source %{dep:sketch.rays})))))

(executable
 (name main)
 (libraries rays rays_pathtracer rdk rdk_rays procedural sop_catalog rays_editor unix workspace_parity))

(rule
 (alias runtest)
 (action (run %{exe:main.exe} --check-workspace)))

(rule
 (alias test_workspace_pixels)
 (locks smoke_window)
 (action (setenv RAYS_WORKSPACE_PIXELS /tmp/rays-workspace-pixels-voxel-wall
  (run %{exe:main.exe} --check-workspace))))

(alias
 (name qualification)
 (deps (alias test_workspace_pixels)))
