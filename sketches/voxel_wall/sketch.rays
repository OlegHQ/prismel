; Voxel wall: a grid of points, each given a depth by the sketch's own Wall
; Depth SOP (fBm noise, defined in main.ml), a packed cube copied onto every
; point. The renderers and the Wall Depth node are OCaml; this is the document.
^:allow-warnings (workspace voxel_wall

  (graph wall :context sop
    (let* [grid (sop/grid :orientation "XY" :connectivity "Triangles"
                          :columns 35 :rows 59 :width 35 :height 59 :size 35)
           cube (sop/box :size [0.86 0.86 1] :center [0 0 0.5])]
      (sop/copy_to_points cube (sop/wall_depth grid) :pack true)))

  (graph scene :context scene
    (let* [wall (scene/geometry (ref wall) :name "wall")
           camera (scene/camera :eye [-4.133102 1.518379 19.482749] :target [0 0 1]
                                :fov 40.107046 :follow_viewport true)
           key (scene/light :name "key" :translate [-34 40 30] :intensity 1650.1184 :width 24 :height 24)
           fill (scene/light :name "fill" :translate [30 -10 26] :intensity 343.7747 :width 30 :height 30)
           sky (scene/world (ref world) :name "studio")]
      (scene/merge wall camera key fill sky)))

  ; A near-black studio.
  (graph world :context world
    (world/gradient :name "studio"
                    :zenith [0.006 0.007 0.009]
                    :horizon [0.006 0.007 0.009]
                    :nadir [0.002 0.002 0.003]
                    :sharpness 1)))
