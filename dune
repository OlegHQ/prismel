 (action
  (setenv PRISMEL_MAX_FRAMES 30
   (run %{exe:sketches/chromatic_drift/main.exe}))))

(rule
 (alias smoke-all)
 (locks smoke_window)
 (deps (source_tree sketches/code_quadtree))
 (action
  (setenv PRISMEL_MAX_FRAMES 30
   ; a small root: indexing the whole build tree takes minutes
   (run %{exe:sketches/code_quadtree/main.exe} --root sketches/code_quadtree))))

