 (action
  (setenv PRISMEL_MAX_FRAMES 30
   (run %{exe:sketches/voxel_wall/main.exe}))))

(rule
 (alias smoke-all)
 (locks smoke_window)
 (action
  (setenv PRISMEL_MAX_FRAMES 30
   (run %{exe:sketches/chromatic_drift/main.exe}))))

(rule
 (alias smoke-all)
 (locks smoke_window)
 (deps (source_tree sketches/code_quadtree))
 (action
  (setenv PRISMEL_MAX_FRAMES 30
   ; a small root: indexing the whole build tree takes minutes
   (run %{exe:sketches/code_quadtree/main.exe} --root sketches/code_quadtree))))

(rule
 (alias smoke-all)
 (locks smoke_window)
 (action
  (setenv PRISMEL_MAX_FRAMES 30
   (run %{exe:sketches/pastel_flow/main.exe}))))

(rule
 (alias smoke-all)
 (locks smoke_window)
 (action
  (setenv PRISMEL_MAX_FRAMES 30
   (run %{exe:sketches/shattered_cube/main.exe}))))

; tools/codemod builds with --profile codemod: the dev warnings plus unused
; modules (60). Warnings stay fatal: dune never replays a cached success.
(env
 (codemod
  (flags
   (-w @1..3@5..28@31..39@43@46..47@49..57@61..62@67@69-40
    -w @60 -strict-sequence -strict-formats -short-paths -keep-locs -g))))
