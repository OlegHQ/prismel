; Pre-commit smoke opens two representative native examples. The explicit
; @smoke-all alias runs every example and sketch. The shared lock keeps
; windows sequential in either target.

(rule
 (alias smoke-all)
 (locks smoke_window)
 (action
  (setenv RAYS_MAX_FRAMES 30
   (run %{exe:examples/audio/lisp.exe}))))

(rule
 (aliases smoke smoke-all)
 (locks smoke_window)
 (action
  (setenv RAYS_MAX_FRAMES 30
   (run %{exe:examples/basic/lisp.exe}))))

(rule
 (aliases smoke smoke-all)
 (locks smoke_window)
 (action
  (setenv RAYS_MAX_FRAMES 30
   (run %{exe:examples/sop_gallery/main.exe}))))

(rule
 (alias smoke-all)
 (locks smoke_window)
 (action
  (setenv RAYS_MAX_FRAMES 30
   (run %{exe:examples/drawing/lisp.exe}))))

