; tools/codemod builds with --profile codemod: the dev warnings plus unused
; modules (60). Warnings stay fatal: dune never replays a cached success.
(env
 (codemod
  (flags
   (-w @1..3@5..28@31..39@43@46..47@49..57@61..62@67@69-40
    -w @60 -strict-sequence -strict-formats -short-paths -keep-locs -g))))
