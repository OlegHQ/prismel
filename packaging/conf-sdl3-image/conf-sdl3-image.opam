opam-version: "2.0"
synopsis: "Virtual package relying on a stable SDL3_image release"
description: "Checks that SDL3_image is at least the floor in packaging/sdl3.lock; tools/packaging/test_sdl3_lock keeps this probe in step with it."
maintainer: ["Oleg Pustovit <oleg@nexo.sh>"]
authors: ["Prismel contributors"]
license: "MIT"
homepage: "https://github.com/nexo-tech/prismel"
bug-reports: "https://github.com/nexo-tech/prismel/issues"
dev-repo: "git+https://github.com/nexo-tech/prismel.git"
flags: conf
depends: [
  "conf-pkg-config" {build}
  "conf-sdl3"
]
depexts: [
  ["sdl3_image"] {os-distribution = "homebrew"}
]
build: [["pkg-config" "--atleast-version=3.4.4" "sdl3-image"]]
