opam-version: "2.0"
synopsis: "Virtual package relying on the audited stable SDL3_mixer release"
description: "Checks the exact SDL3_mixer release qualified by Prismel's generated ABI inventory."
maintainer: ["Oleg Pustovit <oleg@nexo.sh>"]
authors: ["Prismel contributors"]
license: "MIT"
homepage: "https://github.com/nexo-tech/prismel"
bug-reports: "https://github.com/nexo-tech/prismel/issues"
dev-repo: "git+https://github.com/nexo-tech/prismel.git"
flags: conf
depends: [
  "conf-pkg-config" {build}
  "conf-sdl3"
]
depexts: [
  ["sdl3_mixer"] {os-distribution = "homebrew"}
]
build: [["pkg-config" "--exact-version=3.2.4" "sdl3-mixer"]]
