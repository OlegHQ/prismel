(executable
 (name test_main)
 (modules test_main sop_params_fixture test_prismel test_easy_camera2 test_sop_ui test_custom_sop test_pxui_graph test_sketch_ui test_sop_catalog native_only_rendering audio_snapshot sdl3_platform_harness test_sketch_support dependency_gate sop_render_parity)
 (libraries prismel pxui runtime_next_input procedural sop_ui pdk pxui_graph
  sop_catalog scene_command sketch_support sketch_ui unix prismel.sdl3)
 (preprocess (pps prismel.ppx))
 (link_flags -linkall))

(rule
 (aliases runtest test_prismel)
 (action (run %{exe:test_main.exe} test_prismel)))

(rule
 (aliases runtest-native sop_render_parity)
 (action (run %{exe:test_main.exe} sop_render_parity)))

(rule
 (aliases runtest test_easy_camera2)
 (action (run %{exe:test_main.exe} test_easy_camera2)))

(rule
 (aliases runtest test_sop_ui)
 (action (run %{exe:test_main.exe} test_sop_ui)))

(rule
 (aliases runtest test_custom_sop)
 (action (run %{exe:test_main.exe} test_custom_sop)))

(rule
 (aliases runtest test_pxui_graph)
 (action (run %{exe:test_main.exe} test_pxui_graph)))

(rule
 (aliases runtest-native test_sketch_ui)
 (action (run %{exe:test_main.exe} test_sketch_ui)))

(rule
 (aliases runtest test_sop_catalog)
 (action (run %{exe:test_main.exe} test_sop_catalog)))

(rule
 (aliases runtest native_only_rendering)
 (deps ../lib/sdl3/private_raw.ml ../lib/sdl3/sdl3.ml
  ../lib/sdl3/sdl3.mli ../lib/sdl3/sdl3_stubs.c
  ../lib/runtime/runtime_next.ml ../lib/runtime/runtime_next_orchestrator.ml
  ../lib/prismel_next_execution/prismel_next_execution.ml)
 (action
  (run %{exe:test_main.exe} native_only_rendering
   %{dep:../lib/sdl3/private_raw.ml}
   %{dep:../lib/sdl3/sdl3.ml}
   %{dep:../lib/sdl3/sdl3.mli}
   %{dep:../lib/sdl3/sdl3_stubs.c}
   %{dep:../lib/runtime/runtime_next.ml}
   %{dep:../lib/runtime/runtime_next_orchestrator.ml}
   %{dep:../lib/prismel_next_execution/prismel_next_execution.ml})))

(rule
 (aliases runtest audio_snapshot)
 (action
  (setenv SDL_AUDIODRIVER dummy
   (setenv PRISMEL_TEST_AUDIO_SNAPSHOT 1
    (run %{exe:test_main.exe} audio_snapshot)))))

(rule
 (aliases runtest sdl3_platform_harness)
 (action (run %{exe:test_main.exe} sdl3_platform_harness)))

(rule
 (aliases runtest test_sketch_support)
 (action (run %{exe:test_main.exe} test_sketch_support)))

(rule
 (aliases runtest dependency_gate)
 (deps (source_tree ../lib) (source_tree ../ppx) (source_tree ../examples)
  (source_tree ../sketches))
 (action
  (chdir %{workspace_root} (run %{exe:test_main.exe} dependency_gate))))

(rule
 (alias runtest)
 (deps
  ../packaging/conf-sdl3/conf-sdl3.opam
  ../packaging/conf-sdl3-image/conf-sdl3-image.opam
  ../packaging/conf-sdl3-ttf/conf-sdl3-ttf.opam
  ../packaging/conf-sdl3-mixer/conf-sdl3-mixer.opam)
 (action
  (progn
   (run %{exe:../tools/packaging/check_sdl3_conf.exe} sdl3 3.4.14)
   (run %{exe:../tools/packaging/check_sdl3_conf.exe}
    sdl3-image 3.4.4)
   (run %{exe:../tools/packaging/check_sdl3_conf.exe}
    sdl3-ttf 3.2.2)
   (run %{exe:../tools/packaging/check_sdl3_conf.exe}
    sdl3-mixer 3.2.4))))
