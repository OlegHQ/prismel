(rule
 (aliases runtest dependency_gate)
 (deps (source_tree ../lib) (source_tree ../ppx) (source_tree ../examples)
  (source_tree ../sketches))
 (action
  (chdir %{workspace_root} (run %{exe:test_main.exe} dependency_gate))))

(rule
 (alias runtest)
 (deps
  ../packaging/conf-sdl3/conf-sdl3.opam
  ../packaging/conf-sdl3-image/conf-sdl3-image.opam
  ../packaging/conf-sdl3-ttf/conf-sdl3-ttf.opam
  ../packaging/conf-sdl3-mixer/conf-sdl3-mixer.opam)
 (action
  (progn
   (run %{exe:../tools/packaging/check_sdl3_conf.exe} sdl3 3.4.14)
   (run %{exe:../tools/packaging/check_sdl3_conf.exe}
    sdl3-image 3.4.4)
   (run %{exe:../tools/packaging/check_sdl3_conf.exe}
    sdl3-ttf 3.2.2)
   (run %{exe:../tools/packaging/check_sdl3_conf.exe}
    sdl3-mixer 3.2.4))))
