(executable
 (name test_main)
 (modules test_main sop_params_fixture test_prismel test_easy_camera2 test_sop_ui test_custom_sop test_pxui_graph test_prismel_editor test_sop_catalog test_sketch_support test_terminal_boolean_normals dependency_gate sop_render_parity)
 (libraries prismel pxui runtime_input procedural sop_ui pdk pdk_prismel pxui_graph
  sop_catalog scene_command sketch_support prismel_editor unix prismel.sdl3)
 (preprocess (pps prismel.ppx))
 (link_flags -linkall))

