(executable
 (name test_workspace_ir)
 (modules test_workspace_ir)
 (libraries workspace_parity rays_editor sop_catalog unix))

(rule
 (alias test_workspace_ir)
 (deps (source_tree ../examples) (source_tree ../sketches) ../specification/pxui-kit/kit.rays
  (glob_files ../specification/workspace/cases/*.lisp) (glob_files ../specification/workspace/cases/*.rays))
 (action (run %{exe:test_workspace_ir.exe} ..)))

(rule
 (alias test_workspace_pixels)
 (locks smoke_window)
 (deps (source_tree ../examples) (source_tree ../sketches) ../specification/pxui-kit/kit.rays
  (glob_files ../specification/workspace/cases/*.lisp) (glob_files ../specification/workspace/cases/*.rays))
 (action (setenv RAYS_WORKSPACE_PIXELS /tmp/rays-workspace-pixels
  (run %{exe:test_workspace_ir.exe} ..))))

(rule
 (aliases qualification test_scene3_float32_gallery)
 (locks smoke_window)
 (deps (source_tree ../examples) (source_tree ../sketches) ../specification/pxui-kit/kit.rays
  (glob_files ../specification/workspace/cases/*.lisp) (glob_files ../specification/workspace/cases/*.rays))
 (action (setenv RAYS_SCENE3_FLOAT32_COMPARE 1
  (setenv RAYS_WORKSPACE_PIXELS /tmp/rays-scene3-float32
   (run %{exe:test_workspace_ir.exe} ..)))))

