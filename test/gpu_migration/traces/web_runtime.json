{
  "schema": 1,
  "target": "web",
  "event_order": [
    "MouseMoved(13, 17)",
    "MousePressed(LeftButton, (13, 17))",
    "MouseScrolled(0, 1)",
    "KeyPressed(KeyChar 'a')",
    "TextInput(\"A\")",
    "KeyReleased(KeyChar 'a')",
    "MouseReleased(LeftButton, (13, 17))",
    "WindowResized(80, 60)",
    "FileDropped(browser.txt)",
    "WindowFocusLost"
  ],
  "mouse_delta": [13, 17],
  "logical_size": [80, 60],
  "audio_lifecycle": [
    "sample.synth",
    "sample.play",
    "browser.audio_command.receive",
    "browser.asset.fetch",
    "sample.destroy"
  ],
  "resource_lifecycle": [
    "upload.materialize_temp_file",
    "file_drop.emit_owned_path",
    "on_stop.observe_file",
    "runtime.remove_temp_file"
  ]
}
