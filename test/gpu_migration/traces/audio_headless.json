{
  "schema": 1,
  "target": "headless",
  "driver": "SDL dummy audio through SDL_mixer",
  "sample_started": true,
  "sample_stopped": true,
  "music_started": true,
  "music_stopped": true,
  "operations": [
    "sample.load",
    "sample.set_volume",
    "sample.play_loop",
    "sample.pause",
    "sample.resume",
    "sample.stop",
    "music.load",
    "music.set_volume",
    "music.play_loop",
    "music.pause",
    "music.resume",
    "music.stop",
    "audio.stop_all",
    "sample.destroy",
    "sample.destroy_idempotent",
    "music.destroy",
    "music.destroy_idempotent",
    "temporary_wave.remove"
  ]
}
